{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "MkDocs Configuration",
  "type": "object",
  "properties": {
    "site_name": { "type": "string" },
    "site_url": { "type": "string" },
    "use_directory_urls": { "type": "boolean" },
    "theme": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "font": { "type": "object" },
        "logo": { "type": "string" },
        "favicon": { "type": "string" },
        "palette": { "type": "array" }
      }
    },
    "nav": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "additionalProperties": {
              "oneOf": [{ "type": "string" }, { "type": "array" }]
            }
          }
        ]
      }
    },
    "markdown_extensions": {
      "type": "array",
      "items": {}
    }
  },
  "additionalProperties": true
}
